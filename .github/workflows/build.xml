name: Build

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Java 21
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '21'

      - name: Build with Maven
        run: |
          POM=$(find . -name pom.xml -not -path '*/target/*' | head -n 1)
          if [ -z "$POM" ]; then
            echo "No pom.xml found in the repo. Files here:"
            find . -not -path './.git/*' -type f | head -50
            exit 1
          fi
          mvn -B -f "$POM" clean package

      - name: Upload jar
        uses: actions/upload-artifact@v4
        with:
          name: CaneIslands
          path: "**/target/CaneIslands.jar"
